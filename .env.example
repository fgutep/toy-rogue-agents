# Copy this file to .env and fill in real values. .env is gitignored — never
# commit it. Nothing in the codebase auto-loads .env (no dotenv dependency);
# this file is read manually. See docs/OPERATOR_RUNBOOK.md §1 for which of
# these each scenario actually needs.

# --- Required for every containerized run (agentlab up/down) ---
# Single shared bearer token for the Armory cache service.
# Generate with: openssl rand -hex 24
ARMORY_TOKEN=

# --- Model backend keys — set only the ones your run config's agents use ---
# Scenarios 1, 2, 3 all currently use model_backend: openai.
OPENAI_API_KEY=
LUNA_API_KEY=
TERRA_API_KEY=
MISTRAL_API_KEY=

# --- Forensics (post-run, read-only classifier) ---
# Must be a DIFFERENT model family than the one the run itself used, or
# `agentlab forensics` hard-fails (ensure_independent_family). E.g. if the run
# used OPENAI_API_KEY, forensics needs MISTRAL_API_KEY or LUNA_API_KEY/TERRA_API_KEY
# instead — already covered by the block above, just pick a distinct one.

# --- Per-run, set in the shell (not here — it changes every run) ---
# AGENTLAB_RUN_DIR=$PWD/runs/<run-id>
